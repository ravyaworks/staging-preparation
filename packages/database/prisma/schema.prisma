generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  domain    String?  @db.VarChar(255)
  logoUrl   String?
  settings  Json?    @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  users        User[]
  apiKeys      ApiKey[]
  auditLogs    AuditLog[]
  files        File[]
  settingsMeta Setting[]
  webhooks     Webhook[]
  roles        Role[]
  organizations Organization[]
  events       Event[]
  notifications Notification[]
  outreachJobs OutreachJob[]
  channelConnections ChannelConnection[]
  integrations  Integration[]
  contacts      Contact[]
  conversations Conversation[]
  outreachApiKeys OutreachApiKey[]
  featureFlags   FeatureFlag[]
  messages       Message[]

  @@map("tenants")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @db.VarChar(255)
  firstName         String    @db.VarChar(100)
  lastName          String    @db.VarChar(100)
  isActive          Boolean   @default(true)
  isVerified        Boolean   @default(false)
  verificationToken String?   @db.VarChar(255)
  verificationTokenExp DateTime?
  resetToken        String?   @db.VarChar(255)
  resetTokenExp     DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenantId       String  @db.Uuid
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  organizationId String? @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  userRoles  UserRole[]
  sessions   Session[]
  apiKeys    ApiKey[]
  auditLogs  AuditLog[]
  files      File[]
  notifications Notification[]
  conversations Conversation[]
  assignedConversations Conversation[] @relation("assignedConversations")
  campaigns Campaign[]
  campaignLogs CampaignLog[]

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  users           User[]
  campaigns       Campaign[]
  outreachApiKeys OutreachApiKey[]
  importJobs      ImportJob[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("organizations")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  userRoles      UserRole[]
  rolePermissions RolePermission[]

  @@unique([slug, tenantId])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String? @db.Text
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(50)
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([slug])
  @@map("permissions")
}

model UserRole {
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id            String   @id @default(uuid()) @db.Uuid
  token         String   @unique @db.VarChar(512)
  refreshToken  String   @unique @db.VarChar(512)
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.Text
  isActive      Boolean  @default(true)
  expiresAt     DateTime
  lastActivity  DateTime @default(now())
  createdAt     DateTime @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
  @@map("sessions")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(255)
  keyPrefix  String    @db.VarChar(10)
  hash       String    @db.VarChar(255)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String? @db.Uuid
  user     User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("api_keys")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(100)
  entityId  String?  @db.VarChar(255)
  metadata  Json?    @default("{}")
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String? @db.Uuid
  user     User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model File {
  id           String   @id @default(uuid()) @db.Uuid
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  size         Int
  path         String   @db.VarChar(512)
  url          String?  @db.VarChar(512)
  provider     String   @default("local") @db.VarChar(50)
  metadata     Json?    @default("{}")
  createdAt    DateTime @default(now())

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String? @db.Uuid
  user     User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("files")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @db.VarChar(255)
  value     Json
  category  String   @default("general") @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("settings")
}

model Webhook {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(255)
  url             String    @db.VarChar(512)
  secret          String?   @db.VarChar(255)
  events          String[]
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("webhooks")
}

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(100)
  payload     Json
  status      String    @default("pending") @db.VarChar(20)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?   @db.Text
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("events")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   @db.VarChar(50)
  channel   String   @db.VarChar(50)
  recipient String   @db.VarChar(255)
  subject   String?  @db.VarChar(255)
  body      String   @db.Text
  metadata  Json?    @default("{}")
  status    String   @default("pending") @db.VarChar(20)
  sentAt    DateTime?
  createdAt DateTime @default(now())

  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  userId   String? @db.Uuid
  user     User?   @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([tenantId])
  @@map("notifications")
}

model ChannelConnection {
  id           String    @id @default(uuid()) @db.Uuid
  channelType  String    @db.VarChar(50)
  name         String    @db.VarChar(255)
  status       String    @default("disconnected") @db.VarChar(20)
  config       Json?     @default("{}")
  authConfig   Json?     @default("{}")
  connectedAt  DateTime?
  lastActivity DateTime?
  error        String?   @db.Text
  metadata     Json?     @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, channelType])
  @@index([tenantId])
  @@index([channelType])
  @@map("channel_connections")
}

model Integration {
  id          String   @id @default(uuid()) @db.Uuid
  channelType String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  enabled     Boolean  @default(true)
  status      String   @default("pending") @db.VarChar(20)
  settings    Json?    @default("{}")
  error       String?  @db.Text
  connectedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  logs   IntegrationLog[]
  usages IntegrationUsage[]

  @@index([tenantId])
  @@index([channelType])
  @@unique([tenantId, channelType, name])
  @@map("integrations")
}

model IntegrationLog {
  id            String   @id @default(uuid()) @db.Uuid
  type          String   @db.VarChar(20)
  message       String   @db.Text
  metadata      Json?    @default("{}")
  createdAt     DateTime @default(now())

  integrationId String @db.Uuid
  integration   Integration @relation(fields: [integrationId], references: [id])

  @@index([integrationId])
  @@index([createdAt])
  @@map("integration_logs")
}

model IntegrationUsage {
  id              String   @id @default(uuid()) @db.Uuid
  periodStart     DateTime
  periodEnd       DateTime
  messagesSent    Int      @default(0)
  messagesReceived Int     @default(0)
  errors          Int      @default(0)
  totalLatencyMs  Int      @default(0)
  createdAt       DateTime @default(now())

  integrationId String @db.Uuid
  integration   Integration @relation(fields: [integrationId], references: [id])

  @@unique([integrationId, periodStart])
  @@index([integrationId])
  @@map("integration_usages")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  name      String?  @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  email     String?  @db.VarChar(255)
  avatarUrl String?  @db.VarChar(512)
  channels  Json?    @default("[]")
  tags      String[]
  customFields Json? @default("{}")
  notes     String?  @db.Text
  campaignSource String? @db.VarChar(100)
  conversationCount Int   @default(0)
  lastActivityAt  DateTime?
  metadata  Json?   @default("{}")
  isBlocked Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  conversations Conversation[]
  messages       Message[]

  @@index([tenantId])
  @@index([phone])
  @@index([email])
  @@map("contacts")
}

model Conversation {
  id        String            @id @default(uuid()) @db.Uuid
  title     String?           @db.VarChar(255)
  status    String            @default("active") @db.VarChar(20)
  channel   String?           @db.VarChar(50)
  priority  String            @default("normal") @db.VarChar(20)
  labels    String[]
  lastMessageAt  DateTime?
  lastMessagePreview String?  @db.VarChar(500)
  messageCount    Int         @default(0)
  isAiEnabled     Boolean     @default(true)
  isHumanHandoff  Boolean     @default(false)
  slaDeadline     DateTime?
  metadata  Json?             @default("{}")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  tenantId String  @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  userId   String? @db.Uuid
  user     User?   @relation(fields: [userId], references: [id])

  contactId String? @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id])

  assignedToId String? @db.Uuid
  assignedTo   User?   @relation("assignedConversations", fields: [assignedToId], references: [id])

  messages Message[]

  @@index([tenantId])
  @@index([userId])
  @@index([assignedToId])
  @@index([contactId])
  @@index([status])
  @@index([priority])
  @@index([channel])
  @@map("conversations")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  role      String   @db.VarChar(20)
  content   String   @db.Text
  direction String   @default("inbound") @db.VarChar(20)
  messageType String @default("text") @db.VarChar(50)
  status    String   @default("sent") @db.VarChar(20)
  provider  String?  @db.VarChar(50)
  model     String?  @db.VarChar(100)
  tokenCount Int?
  latency   Int?
  attachments Json?  @default("[]")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())

  conversationId String     @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  contactId String? @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id])

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([conversationId])
  @@index([contactId])
  @@index([tenantId])
  @@index([direction])
  @@index([createdAt])
  @@map("messages")
}

model OutreachJob {
  id                   String    @id @default(uuid()) @db.Uuid
  recipientName        String    @db.VarChar(255)
  recipientPhone       String    @db.VarChar(50)
  messageTemplate      String    @db.VarChar(500)
  personalizedMessage  String    @db.Text
  metadata             Json?     @default("{}")
  status               String    @default("pending") @db.VarChar(20)
  attempts             Int       @default(0)
  maxAttempts          Int       @default(3)
  lastError            String?   @db.Text
  senderResult         Json?     @default("{}")
  scheduledAt          DateTime?
  lockedAt             DateTime?
  lockedBy             String?   @db.VarChar(100)
  processedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  campaignId     String?    @db.Uuid
  campaign       Campaign?  @relation(fields: [campaignId], references: [id])

  deliveryEvents DeliveryEvent[]
  failures       JobFailure[]

  @@index([status])
  @@index([tenantId])
  @@index([campaignId])
  @@index([lockedAt])
  @@index([createdAt])
  @@map("outreach_jobs")
}

model Campaign {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(255)
  description  String?   @db.Text
  channel      String    @db.VarChar(50)
  status       String    @default("draft") @db.VarChar(20)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  completedAt  DateTime?
  deletedAt    DateTime?

  organizationId String      @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdBy      String?     @db.Uuid
  creator        User?       @relation(fields: [createdBy], references: [id])

  businesses   CampaignBusiness[]
  statistics   CampaignStatistics[]
  logs         CampaignLog[]
  tags         CampaignTag[]
  outreachJobs OutreachJob[]
  importJobs   ImportJob[]

  @@index([organizationId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@map("campaigns")
}

model CampaignBusiness {
  id                   String   @id @default(uuid()) @db.Uuid
  businessName         String   @db.VarChar(255)
  phone                String   @db.VarChar(50)
  email                String?  @db.VarChar(255)
  industry             String?  @db.VarChar(100)
  previewUrl           String?  @db.VarChar(512)
  personalizedMessage  String   @db.Text
  status               String   @default("pending") @db.VarChar(20)
  errors               Json?    @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  campaignId      String       @db.Uuid
  campaign        Campaign     @relation(fields: [campaignId], references: [id])
  outreachJobId   String? @db.Uuid
  contactId       String? @db.Uuid
  conversationId  String? @db.Uuid

  importRecords ImportRecord[]

  @@unique([campaignId, phone])
  @@index([campaignId])
  @@index([status])
  @@index([contactId])
  @@index([conversationId])
  @@map("campaign_businesses")
}

model CampaignStatistics {
  id              String   @id @default(uuid()) @db.Uuid
  totalBusinesses Int      @default(0)
  jobsCreated     Int      @default(0)
  pending         Int      @default(0)
  queued          Int      @default(0)
  sending         Int      @default(0)
  sent            Int      @default(0)
  delivered       Int      @default(0)
  read            Int      @default(0)
  failed          Int      @default(0)
  replied         Int      @default(0)
  updatedAt       DateTime @updatedAt

  campaignId String  @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId])
  @@map("campaign_statistics")
}

model CampaignLog {
  id         String   @id @default(uuid()) @db.Uuid
  action     String   @db.VarChar(50)
  message    String   @db.Text
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now())

  campaignId String  @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  userId     String? @db.Uuid
  user       User?   @relation(fields: [userId], references: [id])

  @@index([campaignId])
  @@index([createdAt])
  @@map("campaign_logs")
}

model CampaignTag {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(100)
  color      String?  @db.VarChar(20)
  createdAt  DateTime @default(now())

  campaignId String  @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, name])
  @@index([campaignId])
  @@map("campaign_tags")
}

model DeliveryEvent {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   @db.VarChar(50)
  previousStatus String? @db.VarChar(20)
  currentStatus String  @db.VarChar(20)
  timestamp   DateTime @default(now())
  workerId    String?  @db.VarChar(100)
  channel     String?  @db.VarChar(50)
  metadata    Json?    @default("{}")

  jobId       String   @db.Uuid
  job         OutreachJob @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([jobId, timestamp])
  @@index([type])
  @@index([timestamp])
  @@map("delivery_events")
}

model JobFailure {
  id              String    @id @default(uuid()) @db.Uuid
  errorType       String    @db.VarChar(100)
  errorMessage    String    @db.Text
  retryCount      Int       @default(0)
  lastRetryAt     DateTime?
  stackTrace      String?   @db.Text
  resolutionStatus String   @default("unresolved") @db.VarChar(20)
  resolvedAt      DateTime?
  resolvedBy      String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  jobId           String    @db.Uuid
  job             OutreachJob @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([resolutionStatus])
  @@index([errorType])
  @@map("job_failures")
}

model WorkerMetric {
  id                 String   @id @default(uuid()) @db.Uuid
  workerId           String   @db.VarChar(100)
  currentJobId       String?  @db.Uuid
  jobsProcessed      Int      @default(0)
  successCount       Int      @default(0)
  failureCount       Int      @default(0)
  averageProcessingMs Int     @default(0)
  lastHeartbeatAt    DateTime @default(now())
  status             String   @default("idle") @db.VarChar(20)
  startedAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([workerId])
  @@index([status])
  @@index([lastHeartbeatAt])
  @@map("worker_metrics")
}

model DeliveryNotification {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   @db.VarChar(50)
  severity    String   @default("info") @db.VarChar(20)
  title       String   @db.VarChar(255)
  message     String   @db.Text
  metadata    Json?    @default("{}")
  acknowledged   Boolean @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([severity])
  @@index([acknowledged])
  @@index([createdAt])
  @@map("delivery_notifications")
}

model OutreachApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(255)
  key            String    @db.VarChar(255)
  keyPrefix      String    @db.VarChar(20)
  organizationId String    @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  tenantId       String?   @db.Uuid
  tenant         Tenant?   @relation(fields: [tenantId], references: [id])
  createdBy      String?   @db.Uuid
  isActive       Boolean   @default(true)
  allowedIps     Json?     @default("[]")
  rateLimitPerMinute Int   @default(60)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([key])
  @@index([organizationId])
  @@index([keyPrefix])
  @@index([isActive])
  @@map("outreach_api_keys")
}

model ImportJob {
  id             String    @id @default(uuid()) @db.Uuid
  type           String    @default("json") @db.VarChar(20)
  status         String    @default("pending") @db.VarChar(20)
  totalRecords   Int       @default(0)
  successCount   Int       @default(0)
  failedCount    Int       @default(0)
  errorSummary   Json?     @default("[]")
  createdBy      String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  organizationId String  @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  campaignId     String? @db.Uuid
  campaign       Campaign? @relation(fields: [campaignId], references: [id])

  records ImportRecord[]

  @@index([organizationId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
  @@map("import_jobs")
}

model AnalyticsEvent {
  id              String   @id @default(uuid()) @db.Uuid
  type            String   @db.VarChar(100)
  source          String   @db.VarChar(50)
  tenantId        String?  @db.Uuid
  organizationId  String?  @db.Uuid
  userId          String?  @db.Uuid
  campaignId      String?  @db.Uuid
  conversationId  String?  @db.Uuid
  contactId       String?  @db.Uuid
  channel         String?  @db.VarChar(50)
  value           Float?
  data            Json     @default("{}")
  metadata        Json?    @default("{}")
  timestamp       DateTime
  createdAt       DateTime @default(now())

  @@index([type, timestamp])
  @@index([source, timestamp])
  @@index([tenantId, timestamp])
  @@index([organizationId, timestamp])
  @@index([campaignId])
  @@index([conversationId])
  @@index([timestamp])
  @@map("analytics_events")
}

model AnalyticsMetric {
  id              String   @id @default(uuid()) @db.Uuid
  metric          String   @db.VarChar(100)
  value           Float
  dimension       String?  @db.VarChar(255)
  tenantId        String?  @db.Uuid
  organizationId  String?  @db.Uuid
  period          String   @db.VarChar(20)
  bucket          DateTime
  createdAt       DateTime @default(now())

  @@unique([metric, period, bucket, dimension, tenantId, organizationId])
  @@index([metric, tenantId, period, bucket])
  @@index([metric, organizationId, period, bucket])
  @@map("analytics_metrics")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  enabled     Boolean  @default(false)
  isGlobal    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([key])
  @@index([tenantId])
  @@map("feature_flags")
}

model MaintenanceWindow {
  id          String    @id @default(uuid()) @db.Uuid
  message     String    @db.Text
  isActive    Boolean   @default(false)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  allowlist   String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("maintenance_windows")
}

model ImportRecord {
  id          String   @id @default(uuid()) @db.Uuid
  rowNumber   Int?
  businessName String?
  phone       String?
  email       String?
  industry    String?  @db.VarChar(100)
  previewUrl  String?  @db.VarChar(512)
  personalizedMessage String?
  status      String   @default("pending") @db.VarChar(20)
  errors      Json?    @default("[]")
  rawData     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  importJobId        String           @db.Uuid
  importJob          ImportJob         @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  campaignBusinessId String?          @db.Uuid
  campaignBusiness   CampaignBusiness? @relation(fields: [campaignBusinessId], references: [id])

  @@index([importJobId])
  @@index([campaignBusinessId])
  @@index([status])
  @@map("import_records")
}
