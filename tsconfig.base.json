{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "jsx": "preserve",
    "incremental": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "paths": {
      "@conversation-platform/types": ["./packages/types/src"],
      "@conversation-platform/types/*": ["./packages/types/src/*"],
      "@conversation-platform/logger": ["./packages/logger/src"],
      "@conversation-platform/logger/*": ["./packages/logger/src/*"],
      "@conversation-platform/config": ["./packages/config/src"],
      "@conversation-platform/config/*": ["./packages/config/src/*"],
      "@conversation-platform/shared": ["./packages/shared/src"],
      "@conversation-platform/shared/*": ["./packages/shared/src/*"],
      "@conversation-platform/testing": ["./packages/testing/src"],
