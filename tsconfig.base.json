      "@conversation-platform/plugin-engine": ["./packages/plugin-engine/src"],
      "@conversation-platform/plugin-engine/*": ["./packages/plugin-engine/src/*"],
      "@conversation-platform/sdk": ["./packages/sdk/src"],
      "@conversation-platform/sdk/*": ["./packages/sdk/src/*"],
      "@conversation-platform/sdk-js": ["./sdk/javascript/src"],
      "@conversation-platform/sdk-js/*": ["./sdk/javascript/src/*"],
      "@conversation-platform/sdk-react": ["./sdk/react/src"],
      "@conversation-platform/sdk-react/*": ["./sdk/react/src/*"],
      "@conversation-platform/sdk-nextjs": ["./sdk/nextjs/src"],
      "@conversation-platform/sdk-nextjs/*": ["./sdk/nextjs/src/*"],
      "@conversation-platform/sdk-node": ["./sdk/node/src"],
      "@conversation-platform/sdk-node/*": ["./sdk/node/src/*"],
