      "@conversation-platform/audit/*": ["./packages/audit/src/*"],
      "@conversation-platform/campaign": ["./packages/campaign/src"],
      "@conversation-platform/campaign/*": ["./packages/campaign/src/*"],
      "@conversation-platform/campaign-executor": ["./packages/campaign-executor/src"],
      "@conversation-platform/campaign-executor/*": ["./packages/campaign-executor/src/*"],
      "@conversation-platform/outreach-integration": ["./packages/outreach-integration/src"],
      "@conversation-platform/outreach-integration/*": ["./packages/outreach-integration/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "out", "coverage", "apps/dashboard", "apps/documentation", "packages/ui", "playwright.config.ts"]
}
