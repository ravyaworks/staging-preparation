      "@conversation-platform/event-bus": ["./packages/event-bus/src"],
      "@conversation-platform/event-bus/*": ["./packages/event-bus/src/*"],
      "@conversation-platform/storage": ["./packages/storage/src"],
      "@conversation-platform/storage/*": ["./packages/storage/src/*"],
      "@conversation-platform/provider-framework": ["./packages/provider-framework/src"],
      "@conversation-platform/provider-framework/*": ["./packages/provider-framework/src/*"],
      "@conversation-platform/model-registry": ["./packages/model-registry/src"],
