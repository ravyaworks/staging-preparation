      "@conversation-platform/channel-messenger": ["./channels/messenger/src"],
      "@conversation-platform/channel-messenger/*": ["./channels/messenger/src/*"],
      "@conversation-platform/channel-telegram": ["./channels/telegram/src"],
      "@conversation-platform/channel-telegram/*": ["./channels/telegram/src/*"],
      "@conversation-platform/channel-slack": ["./channels/slack/src"],
      "@conversation-platform/channel-slack/*": ["./channels/slack/src/*"],
      "@conversation-platform/channel-discord": ["./channels/discord/src"],
      "@conversation-platform/channel-discord/*": ["./channels/discord/src/*"],
      "@conversation-platform/channel-teams": ["./channels/teams/src"],
