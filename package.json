{
  "name": "conversation-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant AI Conversation Platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:api": "turbo build --filter=@conversation-platform/api",
    "build:dashboard": "turbo build --filter=@conversation-platform/dashboard",
    "test": "turbo test",
    "test:unit": "turbo test --filter=./packages/*",
    "test:integration": "turbo test --filter=./apps/*",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml}\"",
    "clean": "turbo clean && rimraf node_modules",
    "reset": "pnpm clean && pnpm install",
    "prepare": "husky || true",
    "docker:dev": "docker compose -f docker-compose.yml up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=packages/database/prisma/schema.prisma",
    "db:seed": "tsx scripts/database/seed.ts",
    "db:studio": "prisma studio --schema=packages/database/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=packages/database/prisma/schema.prisma"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.1.0",
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.3.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "turbo": "^1.13.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "prisma": "^6.19.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  }
}
