{
  "name": "@conversation-platform/api",
  "version": "0.1.0",
  "private": true,
  "description": "Core API server for the Conversation Platform",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm,cjs",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests || true",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "tsx": "^4.7.0",
    "tsup": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
