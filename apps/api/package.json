{
  "name": "@conversation-platform/api",
  "version": "0.1.0",
  "private": true,
  "description": "Core API server for the Conversation Platform",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm,cjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@conversation-platform/analytics-engine": "workspace:*",
    "@conversation-platform/audit": "workspace:*",
    "@conversation-platform/auth": "workspace:*",
    "@conversation-platform/config": "workspace:*",
    "@conversation-platform/database": "workspace:*",
    "@conversation-platform/knowledge-engine": "workspace:*",
    "@conversation-platform/logger": "workspace:*",
    "@conversation-platform/notification-engine": "workspace:*",
    "@conversation-platform/plugin-framework": "workspace:*",
    "@conversation-platform/tool-engine": "workspace:*",
    "@conversation-platform/tools": "workspace:*",
    "@conversation-platform/workflow-engine": "workspace:*",
    "express": "^4.18.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/express-serve-static-core": "^4.17.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.18.1",
    "supertest": "^7.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
