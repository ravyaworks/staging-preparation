# =============================================================================
# Conversation Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# WARNING: Never commit the actual .env file to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
LOG_LEVEL=debug
PORT=3001
HOST=0.0.0.0

# --- Database (PostgreSQL) ---
# Use a strong, unique password in production.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/conversation_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=conversation_platform

# --- Redis ---
# Use a strong, unique password in production.
REDIS_URL=redis://:CHANGE_ME@localhost:6379
REDIS_PASSWORD=CHANGE_ME

# --- Authentication ---
# Generate with: openssl rand -base64 32
JWT_SECRET=generate-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Encryption ---
# Generate with: openssl rand -base64 32 (must be exactly 32 bytes)
ENCRYPTION_KEY=generate-a-random-32-byte-key-here!

# --- WhatsApp Cloud API ---
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_API_VERSION=v18.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret

# --- OpenAI / AI Engine ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# --- Monitoring ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=${NODE_ENV}
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Domain (Production) ---
DOMAIN=api.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# --- Traefik Dashboard ---
# Generate password with: htpasswd -nb admin securepassword
# Format: username:hashedpassword
TRAEFIK_USERS=admin:$2y$10$yourhashedpassword

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME

# --- Worker ---
WORKER_REPLICAS=2
