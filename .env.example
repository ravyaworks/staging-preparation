# =============================================================================
# Conversation Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# WARNING: Never commit the actual .env file to version control.
# =============================================================================
#
# ── Quick Start ─────────────────────────────────────────────────────────────
#   1. cp .env.example .env
#   2. Edit .env with your secrets
#   3. docker compose -f docker-compose.staging.yml up -d
#   4. pnpm db:migrate  (first time only)
#   5. pnpm db:seed     (optional, creates default admin)
# =============================================================================


# ═════════════════════════════════════════════════════════════════════════════
# APPLICATION
# ═════════════════════════════════════════════════════════════════════════════

# Node environment: development, staging, production
NODE_ENV=staging

# Application port (API listens here)
# Must match the port in docker-compose.staging.yml (default 3001)
PORT=3001

# Host binding
HOST=0.0.0.0

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Enable pretty-print logging (development only, disable in staging/production)
LOG_PRETTY=false

# Application name
APP_NAME=conversation-platform


# ═════════════════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL)
# ═════════════════════════════════════════════════════════════════════════════

# Full connection string (used by the application)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://cp_user:cp_staging_password@localhost:5432/conversation_platform

# Docker Compose values (must match DATABASE_URL above)
POSTGRES_USER=cp_user
POSTGRES_PASSWORD=cp_staging_password
POSTGRES_DB=conversation_platform

# Connection pool limits
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10


# ═════════════════════════════════════════════════════════════════════════════
# REDIS
# ═════════════════════════════════════════════════════════════════════════════

# Full connection string (used by the application)
# Format: redis://[:PASSWORD]@HOST:PORT
REDIS_URL=redis://:cp_staging_redis@localhost:6379

# Docker Compose value (must match REDIS_URL password)
REDIS_PASSWORD=cp_staging_redis


# ═════════════════════════════════════════════════════════════════════════════
# AUTHENTICATION
# ═════════════════════════════════════════════════════════════════════════════

# JWT signing secret
# Generate with: openssl rand -base64 32
JWT_SECRET=generate-a-random-secret-at-least-32-chars-long

# JWT token expiry
JWT_EXPIRES_IN=15m

# Refresh token expiry
REFRESH_TOKEN_EXPIRES_IN=7d

# Bcrypt rounds for password hashing (higher = slower, more secure)
BCRYPT_ROUNDS=12


# ═════════════════════════════════════════════════════════════════════════════
# ENCRYPTION
# ═════════════════════════════════════════════════════════════════════════════

# Encryption key for sensitive data at rest
# Generate with: openssl rand -base64 32 (must be exactly 32 bytes)
ENCRYPTION_KEY=generate-a-random-32-byte-key-here-exactly


# ═════════════════════════════════════════════════════════════════════════════
# WHATSAPP CLOUD API (Meta WhatsApp Business Platform)
# ═════════════════════════════════════════════════════════════════════════════

# WhatsApp Business API access token (system user permanent token)
# Must have whatsapp_business_messaging + whatsapp_business_management permissions
# Generate from: Meta Business Suite → Users → System Users → Generate Token
WHATSAPP_ACCESS_TOKEN=EAAT...

# WhatsApp phone number ID (numeric, from Meta App → WhatsApp → API Setup)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# WhatsApp Business Account ID (WABA ID, from Meta App → WhatsApp → API Setup)
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# WhatsApp API version (default: v21.0)
WHATSAPP_API_VERSION=v21.0

# Webhook verify token (custom string, must match what you enter in Meta dashboard)
# Minimum 8 characters for security
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token

# Meta App Secret (from Meta Developers → Your App → Settings → Basic)
# Used for X-Hub-Signature-256 webhook body verification
# If set, every incoming webhook POST is cryptographically verified
WHATSAPP_APP_SECRET=your-app-secret

# Optional: Override the Graph API base URL
# WHATSAPP_BASE_URL=https://graph.facebook.com

# Optional: Request timeout in milliseconds (default: 30000)
# WHATSAPP_REQUEST_TIMEOUT_MS=30000

# Optional: Max retries for failed API calls (default: 3)
# WHATSAPP_MAX_RETRIES=3

# Optional: Base retry delay in ms (default: 1000, doubles per attempt)
# WHATSAPP_RETRY_DELAY_MS=1000


# ═════════════════════════════════════════════════════════════════════════════
# AI ENGINE
# ═════════════════════════════════════════════════════════════════════════════

# OpenAI API key
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI model to use
OPENAI_MODEL=gpt-4o-mini

# Anthropic API key (optional, for Claude models)
ANTHROPIC_API_KEY=

# Gemini API key (optional)
GEMINI_API_KEY=

# AI temperature (0.0 - 1.0)
AI_TEMPERATURE=0.7

# Max tokens per AI response
AI_MAX_TOKENS=1024

# Embedding model (for knowledge engine)
EMBEDDING_MODEL=text-embedding-3-small


# ═════════════════════════════════════════════════════════════════════════════
# CORS
# ═════════════════════════════════════════════════════════════════════════════

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Allowed HTTP methods
CORS_METHODS=GET,POST,PUT,PATCH,DELETE


# ═════════════════════════════════════════════════════════════════════════════
# RATE LIMITING
# ═════════════════════════════════════════════════════════════════════════════

# Rate limit window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Auth endpoint rate limit (requests per window)
RATE_LIMIT_AUTH_MAX=20


# ═════════════════════════════════════════════════════════════════════════════
# FILE UPLOADS
# ═════════════════════════════════════════════════════════════════════════════

# Upload directory (relative to app root, or absolute path)
UPLOAD_DIR=./uploads

# Maximum file size in megabytes
MAX_FILE_SIZE_MB=10

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx,.csv,.mp3,.mp4,.txt


# ═════════════════════════════════════════════════════════════════════════════
# DASHBOARD
# ═════════════════════════════════════════════════════════════════════════════

# Dashboard app port
DASHBOARD_PORT=3000

# Dashboard API URL (used by the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001


# ═════════════════════════════════════════════════════════════════════════════
# MONITORING
# ═════════════════════════════════════════════════════════════════════════════

# Sentry DSN (optional, for error tracking)
SENTRY_DSN=

# Sentry environment tag
SENTRY_ENVIRONMENT=${NODE_ENV}

# Sentry traces sample rate (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=staging_grafana


# ═════════════════════════════════════════════════════════════════════════════
# SMTP / EMAIL
# ═════════════════════════════════════════════════════════════════════════════

# SMTP server for transactional emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com


# ═════════════════════════════════════════════════════════════════════════════
# DOMAIN & HTTPS (Production only - not used in staging)
# ═════════════════════════════════════════════════════════════════════════════

# Primary domain
DOMAIN=api.yourdomain.com

# ACME email for Let's Encrypt
ACME_EMAIL=admin@yourdomain.com

# Traefik basic auth (format: username:hashedpassword)
# Generate with: htpasswd -nb admin securepassword
TRAEFIK_USERS=admin:$2y$10$yourhashedpassword


# ═════════════════════════════════════════════════════════════════════════════
# WORKER
# ═════════════════════════════════════════════════════════════════════════════

# Number of worker replicas (docker-compose.prod.yml only)
WORKER_REPLICAS=2
