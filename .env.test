# Environment Variables
NODE_ENV=test
PORT=0
HOST=localhost

# Database
DATABASE_URL=postgresql://cp_user:cp_password@localhost:5432/conversation_platform_test

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=test-secret-do-not-use-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,PATCH,DELETE

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=silent
LOG_PRETTY=true
